// Cloudflare Workers deployment of the Team Huntington Hub.
// Build first (`npm run build`), then deploy through the release process in
// docs/DEPLOYMENT.md. Secrets are set with `wrangler secret put` and never
// committed; see docs/CONFIGURATION.md for the full list.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ride-with-huntington",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".output/public", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "routes": [{ "pattern": "ridewithhuntington.madebyotten.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "PUBLIC_ORIGIN": "https://ridewithhuntington.madebyotten.com",
    "AUTH_BASE_URL": "https://auth.madebyaspire.com",
    "AUTH_CLIENT_ID": "team-huntington-hub",
    "AUTH_ORG_SLUG": "team-huntington",
    "HUB_DB_URL": "https://rwh-db.madebyotten.com",
    "EMAIL_PROVIDER": "resend",
    "EMAIL_FROM": "Team Huntington Hub <hub@send.madebyaspire.com>",
    "HUB_REQUIRE_SIGN_IN": "true"
  },
  "d1_databases": [
    {
      "binding": "HUB_SESSIONS",
      "database_name": "ride-with-huntington-sessions",
      "database_id": "f3ebe3a1-1839-41de-98a4-e4347ae4301b",
      "migrations_dir": "deploy/cloudflare/d1-migrations"
    }
  ],
  "r2_buckets": [{ "binding": "HUB_FILES", "bucket_name": "ride-with-huntington-files" }]
}
