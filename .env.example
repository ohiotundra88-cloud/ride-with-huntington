# Team Huntington Hub: example configuration.
#
# Copy to .env.local for local development (it is gitignored):
#   cp .env.example .env.local
# `npm run dev` loads .env.local into the server's environment.
# In hosted environments set the same names as App Settings (Azure) or
# vars/secrets (Cloudflare). Every value below is fake.
# Full reference: docs/CONFIGURATION.md

# ---------------------------------------------------------------------------
# Web app: site
# ---------------------------------------------------------------------------

# The Hub's own public origin, no trailing slash. Used to build the sign-in
# redirect URI (<PUBLIC_ORIGIN>/auth/callback). Must match the browser URL.
PUBLIC_ORIGIN=http://localhost:5173

# "true" puts every page and API behind sign-in (private preview).
# Leave empty to keep the home page, family guide and public fundraiser pages open.
HUB_REQUIRE_SIGN_IN=

# ---------------------------------------------------------------------------
# Web app: sign-in (OpenID Connect provider; read in src/server/session.server.ts)
# ---------------------------------------------------------------------------

# Base URL of the identity provider. Today this is Aspire Identity; the issuer
# is <AUTH_BASE_URL>/api/auth. See docs/ENTRA.md for Microsoft Entra ID.
AUTH_BASE_URL=https://identity.example.com
AUTH_CLIENT_ID=team-huntington-hub-local
AUTH_CLIENT_SECRET=replace-with-client-secret
# Organization the signed-in person must belong to (Aspire Identity "orgs" claim).
AUTH_ORG_SLUG=team-huntington
# Signs the session cookie. At least 32 random characters. Changing it signs everyone out.
SESSION_SECRET=replace-with-at-least-32-random-characters-0000

# ---------------------------------------------------------------------------
# Web app: database (read in src/server/backend.server.ts)
# ---------------------------------------------------------------------------

# Base URL of the database gateway. The app calls <HUB_DB_URL>/rest/v1/<table>,
# so this must be a proxy that forwards /rest/v1/* to PostgREST's root.
# See docs/DEPLOYMENT.md, "The /rest/v1 gateway".
HUB_DB_URL=http://localhost:3001
# Shared HS256 secret. Must equal PostgREST's PGRST_JWT_SECRET. At least 32 characters.
HUB_DB_JWT_SECRET=replace-with-the-same-secret-postgrest-uses-000
# Only when the database gateway sits behind Cloudflare Access (the temporary preview).
HUB_DB_ACCESS_CLIENT_ID=
HUB_DB_ACCESS_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Web app: email (read in src/lib/email-templates/send-email.ts)
# ---------------------------------------------------------------------------

# "resend" (default) sends through Resend. "log" prints messages to the server log.
EMAIL_PROVIDER=log
EMAIL_FROM=Team Huntington Hub <hub@example.com>
# Required when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Send every message to this one inbox instead of the real recipient.
# Set it on every non-production copy of the Hub.
EMAIL_REDIRECT_TO=test-inbox@example.com

# ---------------------------------------------------------------------------
# Pelotonia public data (read by the web app and by jobs/pelotonia-sync)
# ---------------------------------------------------------------------------

# Optional. Defaults are Pelotonia's public data service and Team Huntington's peloton.
PELOTONIA_API_BASE=
PELOTONIA_TEAM_PELOTON_ID=

# ---------------------------------------------------------------------------
# Nightly Pelotonia sync job (jobs/pelotonia-sync; not read by the web app)
# ---------------------------------------------------------------------------

# PostgREST root URL (no /rest/v1). The job talks to PostgREST directly.
HUB_REST_URL=http://localhost:3000
# The job also needs HUB_DB_JWT_SECRET (above).
# "all" (default), "stale" (profiles older than 20 hours) or "none".
SYNC_PROFILES=
# Cap on rider profiles fetched per run. Empty means no cap.
SYNC_MAX_PROFILES=
# Comma-separated PledgeIt campaign slugs for Pelotonia Kids. Empty string skips PledgeIt.
PLEDGEIT_KIDS_SLUGS=PelotoniaKids-TeamHuntington
# scheduler.mjs only: daily run time (24h HH:MM) in the TZ below.
SYNC_AT=03:30
TZ=America/New_York

# ---------------------------------------------------------------------------
# Local database tooling (reset.sh, npm run test:db, scripts/gen-db-types.mjs)
# ---------------------------------------------------------------------------
# These are read from your shell, not from .env.local. Export them if your
# PostgreSQL is not on the defaults (Unix socket in /tmp, port 54329).
#   export PGHOST=localhost PGPORT=5432 PGDATABASE_TEST=rwh_test
#   export PSQL=psql LC_ALL=en_US.UTF-8
#   export DATABASE_URL=postgresql://postgres@localhost:5432/rwh_test

# ---------------------------------------------------------------------------
# Build and Node server runtime
# ---------------------------------------------------------------------------
# NITRO_PRESET is set by the npm scripts (build = cloudflare-module,
# build:node = node-server). PORT and HOST apply to the Node server:
#   PORT=8080 HOST=0.0.0.0 node .output/server/index.mjs
